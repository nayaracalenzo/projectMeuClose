    "db:fix:products-test-dates": "node src/scripts/fixImportedProductsTestDates.js",
    "db:setup:products": "npm run db:migrate && npm run db:seed:products",
    "db:seed:clothings-type": "node src/scripts/importClothingsType.js",
    "db:setup:clothings-type": "npm run db:migrate && npm run db:seed:clothings-type",
